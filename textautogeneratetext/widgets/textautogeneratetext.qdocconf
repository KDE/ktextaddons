include($KDE_DOCS/global/qt-module-defaults.qdocconf)

project = TextAutoGenerateText
moduleheader = textautogeneratetext_qdocmoduleheader.h
description = TextAutoGenerateText provides AI support.


documentationinheaders = true

headers += \
    configure/textautogeneratetextconfiguremcpserverswidget.h \
    configure/textautogeneratetextconfigurepluginswidget.h \
    configure/textautogeneratetextconfigurepromptwidget.h \
    configuretoolsplugin/textautogeneratetoolpluginconfigurewidget.h \
    instancesmanager/textautogeneratetextinstancesmanagerdialog.h \
    instancesmanager/textautogeneratetextinstancesmanagerwidget.h \
    menu/textautogeneratemenuconfiguredialog.h \
    menu/textautogeneratemenuconfigurewidget.h \
    menu/textautogeneratemenutextinfo.h \
    menu/textautogeneratemenutextmanager.h \
    menu/textautogeneratemenuwidget.h \
    networkpluginconfigure/textautogeneratenetworkpluginconfigurewidget.h \
    plugintext/textautogenerateplugintext.h \
    plugintext/textautogenerateplugintextinterface.h \
    plugintext/textautogenerateplugintextmanager.h \
    quickask/textautogeneratequickaskdialog.h \
    quickask/textautogeneratequickaskwidget.h \
    textautogeneratedialog.h \
    textautogeneratestackwidget.h \
    textautogeneratetext_qdocmoduleheader.h \
    textautogeneratewidget.h \
    view/delegate/textautogeneratelistviewbasedelegate.h \
    view/delegate/textautogeneratelistviewdelegate.h \
    view/delegate/textautogeneratelistviewmessagebasedelegate.h \
    view/lrucache.h \
    view/textautogeneratebaselistview.h \
    view/textautogeneratedelegateutils.h \
    view/textautogeneratemessagewaitingansweranimation.h \
    view/textautogeneratemessagewaitingansweranimationbase.h
sourcedirs += .

excludedirs += \
    autotests \
    availablemodel/autotests \
    mcp/autotests \
    menu/autotests \
    projects/autotests \
    promptswidget/autotests \
    tags/autotests

outputformats = HTML

depends += \
    qtcore \
    textautogeneratetextcore

navigation.landingpage = "TextAutoGenerateText"

qhp.projects            = textautogeneratetext

qhp.textautogeneratetext.file                = textautogeneratetext.qhp
qhp.textautogeneratetext.namespace           = org.kde.textautogeneratetext.$QT_VERSION_TAG
qhp.textautogeneratetext.virtualFolder       = textautogeneratetext
qhp.textautogeneratetext.indexTitle          = TextAutoGenerateText
qhp.textautogeneratetext.indexRoot           =

qhp.textautogeneratetext.subprojects         = classes
qhp.textautogeneratetext.subprojects.classes.title = C++ Classes
qhp.textautogeneratetext.subprojects.classes.indexTitle = TextAutoGenerateText C++ Classes
qhp.textautogeneratetext.subprojects.classes.selectors = class fake:headerfile
qhp.textautogeneratetext.subprojects.classes.sortPages = true

tagfile = textautogeneratetext.tags
