include($KDE_DOCS/global/qt-module-defaults.qdocconf)

project = TextGrammarCheck
moduleheader = textgrammarcheck_qdocmoduleheader.h
description = TextGrammarCheck provides grammar check support.


documentationinheaders = true

headers += \
    common/grammaraction.h \
    common/grammarerror.h \
    common/grammarresulttextedit.h \
    common/grammarresultwidget.h \
    grammalecte/grammalecteconfigdialog.h \
    grammalecte/grammalecteconfigwidget.h \
    grammalecte/grammalectegenerateconfigoptionjob.h \
    grammalecte/grammalectemanager.h \
    grammalecte/grammalecteresultjob.h \
    grammalecte/grammalecteresultwidget.h \
    languagetool/languageinfo.h \
    languagetool/languagetoolcombobox.h \
    languagetool/languagetoolconfigdialog.h \
    languagetool/languagetoolconfigwidget.h \
    languagetool/languagetoolgetlistoflanguagejob.h \
    languagetool/languagetoolmanager.h \
    languagetool/languagetoolresultwidget.h \
    textgrammarcheck_qdocmoduleheader.h
sourcedirs += .

excludedirs += \
    common/autotests \
    grammalecte/autotests \
    grammalecte/tests \
    languagetool/autotests \
    languagetool/tests

outputformats = HTML

depends += \
    qtcore

navigation.landingpage = "TextGrammarCheck"

qhp.projects            = textgrammarcheck

qhp.textgrammarcheck.file                = textgrammarcheck.qhp
qhp.textgrammarcheck.namespace           = org.kde.textgrammarcheck.$QT_VERSION_TAG
qhp.textgrammarcheck.virtualFolder       = textgrammarcheck
qhp.textgrammarcheck.indexTitle          = TextGrammarCheck
qhp.textgrammarcheck.indexRoot           =

qhp.textgrammarcheck.subprojects         = classes
qhp.textgrammarcheck.subprojects.classes.title = C++ Classes
qhp.textgrammarcheck.subprojects.classes.indexTitle = TextGrammarCheck C++ Classes
qhp.textgrammarcheck.subprojects.classes.selectors = class fake:headerfile
qhp.textgrammarcheck.subprojects.classes.sortPages = true

tagfile = textgrammarcheck.tags
