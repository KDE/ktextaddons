include($KDE_DOCS/global/qt-module-defaults.qdocconf)

project = TextAddonsWidgets
moduleheader = textaddonswidgets_qdocmoduleheader.h
description = TextAddonsWidgets provides some addons widgets.


documentationinheaders = true

headers += \
    completionlineedit/completionlineedit.h \
    completionlineedit/completionlistview.h \
    layout/textaddonswidgetflowlayout.h \
    misc/executableutils.h \
    misc/loaddialogsizeutils.h \
    misc/openfilejob.h \
    misc/savefileutils.h \
    model/sortfilterproxymodelbase.h \
    needupdateversion/needupdatecheckexistingnewversionjob.h \
    needupdateversion/needupdateparsehtmljob.h \
    needupdateversion/needupdateparsehtmlutil.h \
    needupdateversion/needupdateversionutils.h \
    needupdateversion/needupdateversionwidget.h \
    opensavedfilefolderwidget.h \
    plugins/configurepluginswidget.h \
    plugins/pluginutil.h \
    quicksearchbar/quicksearchbar.h \
    quicksearchbar/quicksearchbarwidget.h \
    richtextquicktextformat.h \
    selectspecialchardialog.h \
    slidecontainer.h \
    textaddonswidgets_qdocmoduleheader.h \
    textmessagewidget.h \
    verifynewversion/verifynewversionwidget.h \
    whatsnew/whatsnewcomboboxwidget.h \
    whatsnew/whatsnewdialog.h \
    whatsnew/whatsnewinfo.h \
    whatsnew/whatsnewmessagewidget.h \
    whatsnew/whatsnewtranslationsbase.h \
    whatsnewng/whatsnewmessagengwidget.h \
    whatsnewng/whatsnewngdialog.h \
    whatsnewng/whatsnewngutils.h
sourcedirs += .

excludedirs += \
    autotests \
    misc/autotests \
    needupdateversion/autotests \
    needupdateversion/tests \
    quicksearchbar/autotests \
    tests \
    whatsnewng/autotests \
    whatsnewng/tests

outputformats = HTML

depends += \
    qtcore

navigation.landingpage = "TextAddonsWidgets"

qhp.projects            = textaddonswidgets

qhp.textaddonswidgets.file                = textaddonswidgets.qhp
qhp.textaddonswidgets.namespace           = org.kde.textaddonswidgets.$QT_VERSION_TAG
qhp.textaddonswidgets.virtualFolder       = textaddonswidgets
qhp.textaddonswidgets.indexTitle          = TextAddonsWidgets
qhp.textaddonswidgets.indexRoot           =

qhp.textaddonswidgets.subprojects         = classes
qhp.textaddonswidgets.subprojects.classes.title = C++ Classes
qhp.textaddonswidgets.subprojects.classes.indexTitle = TextAddonsWidgets C++ Classes
qhp.textaddonswidgets.subprojects.classes.selectors = class fake:headerfile
qhp.textaddonswidgets.subprojects.classes.sortPages = true

tagfile = textaddonswidgets.tags
