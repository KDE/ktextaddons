include($KDE_DOCS/global/qt-module-defaults.qdocconf)

project = TextEmoticonsCore
moduleheader = textemoticonscore_qdocmoduleheader.h
description = TextEmoticonsCore provides emoticon core lib.


documentationinheaders = true

headers += \
    customemoji.h \
    customemojiiconmanager.h \
    emojimodel.h \
    emojimodelmanager.h \
    emojisortfilterproxymodel.h \
    emoticoncategory.h \
    emoticonunicodeutils.h \
    runninganimatedimage.h \
    textemoticonscore_qdocmoduleheader.h \
    unicodeemoticon.h \
    unicodeemoticonmanager.h \
    unicodeemoticonparser.h
sourcedirs += .

excludedirs += \
    autotests

outputformats = HTML

depends += \
    qtcore

navigation.landingpage = "TextEmoticonsCore"

qhp.projects            = textemoticonscore

qhp.textemoticonscore.file                = textemoticonscore.qhp
qhp.textemoticonscore.namespace           = org.kde.textemoticonscore.$QT_VERSION_TAG
qhp.textemoticonscore.virtualFolder       = textemoticonscore
qhp.textemoticonscore.indexTitle          = TextEmoticonsCore
qhp.textemoticonscore.indexRoot           =

qhp.textemoticonscore.subprojects         = classes
qhp.textemoticonscore.subprojects.classes.title = C++ Classes
qhp.textemoticonscore.subprojects.classes.indexTitle = TextEmoticons Core C++ Classes
qhp.textemoticonscore.subprojects.classes.selectors = class fake:headerfile
qhp.textemoticonscore.subprojects.classes.sortPages = true

tagfile = textemoticonscore.tags
