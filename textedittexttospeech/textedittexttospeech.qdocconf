include($KDE_DOCS/global/qt-module-defaults.qdocconf)

project = TextEditTextToSpeech
moduleheader = textedittexttospeech_qdocmoduleheader.h
description = TextEditTextToSpeech provides text to speech api.


documentationinheaders = true

headers += \
    textedittexttospeech_qdocmoduleheader.h \
    texttospeech.h \
    texttospeechactions.h \
    texttospeechconfigdialog.h \
    texttospeechconfiginterface.h \
    texttospeechconfigwidget.h \
    texttospeechcontainerwidget.h \
    texttospeechinterface.h \
    texttospeechwidget.h
sourcedirs += .

excludedirs += \
    autotests \
    kokoro/autotests \
    kokoroinstall/autotests \
    tests

outputformats = HTML

depends += \
    qtcore

navigation.landingpage = "TextEditTextToSpeech"

qhp.projects            = textedittexttospeech

qhp.textedittexttospeech.file                = textedittexttospeech.qhp
qhp.textedittexttospeech.namespace           = org.kde.textedittexttospeech.$QT_VERSION_TAG
qhp.textedittexttospeech.virtualFolder       = textedittexttospeech
qhp.textedittexttospeech.indexTitle          = TextEditTextToSpeech
qhp.textedittexttospeech.indexRoot           =

qhp.textedittexttospeech.subprojects         = classes
qhp.textedittexttospeech.subprojects.classes.title = C++ Classes
qhp.textedittexttospeech.subprojects.classes.indexTitle = TextEditTextToSpeech C++ Classes
qhp.textedittexttospeech.subprojects.classes.selectors = class fake:headerfile
qhp.textedittexttospeech.subprojects.classes.sortPages = true

tagfile = textedittexttospeech.tags
